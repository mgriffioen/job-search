{
  "_readme": "Model v3 — the fit-profile matcher, written from the job-search matching specification. This is an OVERLAY on config/profile.json, like profile.v2.json: search terms, engagement, skills, penalties, location and the exclusion list are inherited, and only what defines this model lives here. v3 does not score one blended number out of a title and some keywords. It scores four separate axes — WORK FIT (what she would actually do all day), EXPERIENCE FIT (how much of that work she has already done), QUALIFICATION FIT (the employer's stated requirements) and LIFESTYLE FIT (remote, contract, flexibility) — and weights them 35/30/20/15 into the overall score. The bands, the recommendation, the learnable-vs-true gap split and the freshness rules are all from the spec.",

  "search": {
    "_comment": "Quality over quantity: this board publishes far fewer postings than v1 and v2. minMatchScore sits just under the spec's 70-point 'possible adjacent opportunity' band so near-misses stay reachable with the slider, and everything below that is dropped rather than stored.",
    "minMatchScore": 65,
    "maxJobsStored": 400,
    "_freshnessComment": "The spec hides anything over 30 days by default unless it is unusually strong. staleAfterDays is that cutoff; a posting older than it survives only by scoring staleKeepMinMatch or better, and is labelled as needing its availability confirmed.",
    "staleAfterDays": 30,
    "staleKeepMinMatch": 88
  },

  "ranking": {
    "_comment": "Freshness is 'extremely important' per the spec, so the half-life is shorter here than on the other boards and the bucket bonuses below sharpen it further. These adjust the sort order only — never the score, which has to keep meaning what the bands say it means.",
    "matchWeight": 0.7,
    "recencyWeight": 0.3,
    "recencyHalfLifeDays": 10,
    "assumedAgeDaysWhenUnknown": 21
  },

  "_axisWeightsComment": "The spec's weighting, and the only place it is defined.",
  "axisWeights": {
    "work": 0.35,
    "experience": 0.3,
    "qualification": 0.2,
    "lifestyle": 0.15
  },

  "_bandsComment": "The spec's result labels, highest first. `recommendation` is what the card prints as the call to action.",
  "bands": [
    { "min": 95, "tier": "exceptional", "label": "Exceptional match — apply ASAP", "recommendation": "APPLY ASAP" },
    { "min": 88, "tier": "strong", "label": "Strong match — priority application", "recommendation": "APPLY" },
    { "min": 80, "tier": "good", "label": "Good match — review carefully", "recommendation": "APPLY" },
    { "min": 70, "tier": "possible", "label": "Possible adjacent opportunity", "recommendation": "CONSIDER" },
    { "min": 0, "tier": "low", "label": "Low priority", "recommendation": "SKIP" }
  ],

  "_freshnessBucketsComment": "Sort-order bonuses only. maxDays is inclusive; the last bucket catches everything older.",
  "freshnessBuckets": [
    { "maxDays": 3, "label": "Posted in the last 3 days", "rankBonus": 6 },
    { "maxDays": 7, "label": "Posted this week", "rankBonus": 3 },
    { "maxDays": 14, "label": "Posted in the last two weeks", "rankBonus": 0 },
    { "maxDays": 30, "label": "Over two weeks old", "rankBonus": -4 },
    { "maxDays": null, "label": "Over a month old — confirm it is still open", "rankBonus": -10 }
  ],

